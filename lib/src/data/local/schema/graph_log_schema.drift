AFTER DELETE ON daily_choices
WHEN (SELECT capture FROM graph_log_control) = 1
BEGIN
  INSERT OR IGNORE INTO graph_log_daily_choice_marks (
    daily_choice_id, first_operation
  ) VALUES (old.id, 'delete');
END;

-- Путь — часть записи дневного выбора, поэтому изменение шага отмечает
-- изменение своего выбора.
CREATE TRIGGER graph_log_mark_daily_choice_path_step_insert
AFTER INSERT ON daily_choice_path_steps
WHEN (SELECT capture FROM graph_log_control) = 1
BEGIN
  INSERT OR IGNORE INTO graph_log_daily_choice_marks (
    daily_choice_id, first_operation
  ) VALUES (new.daily_choice_id, 'update');
END;

CREATE TRIGGER graph_log_mark_daily_choice_path_step_update
AFTER UPDATE ON daily_choice_path_steps
WHEN (SELECT capture FROM graph_log_control) = 1
BEGIN
  INSERT OR IGNORE INTO graph_log_daily_choice_marks (
    daily_choice_id, first_operation
  ) VALUES (old.daily_choice_id, 'update'), (new.daily_choice_id, 'update');
END;

CREATE TRIGGER graph_log_mark_daily_choice_path_step_delete
AFTER DELETE ON daily_choice_path_steps
WHEN (SELECT capture FROM graph_log_control) = 1
BEGIN
  INSERT OR IGNORE INTO graph_log_daily_choice_marks (
    daily_choice_id, first_operation
  ) VALUES (old.daily_choice_id, 'update');
END;
