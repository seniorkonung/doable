AFTER DELETE ON long_term_relations
WHEN (SELECT capture FROM graph_log_control) = 1
BEGIN
  INSERT OR IGNORE INTO graph_log_long_term_relation_marks (
    long_term_relation_id, first_operation
  ) VALUES (old.id, 'delete');
END;

CREATE TRIGGER graph_log_mark_daily_choice_insert
AFTER INSERT ON daily_choices
WHEN (SELECT capture FROM graph_log_control) = 1
BEGIN
  INSERT OR IGNORE INTO graph_log_daily_choice_marks (
    daily_choice_id, first_operation
  ) VALUES (new.id, 'insert');
END;

CREATE TRIGGER graph_log_mark_daily_choice_update
AFTER UPDATE ON daily_choices
WHEN (SELECT capture FROM graph_log_control) = 1
BEGIN
  INSERT OR IGNORE INTO graph_log_daily_choice_marks (
    daily_choice_id, first_operation
  ) VALUES (new.id, 'update');
END;

