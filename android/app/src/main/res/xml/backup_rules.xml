<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 и ниже используют full-backup-content. Исключение каталога
  database покрывает SQLite-файл и его служебные файлы.
  Источник: https://developer.android.com/identity/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="." />
</full-backup-content>
