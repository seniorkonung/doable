<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ применяет разные правила к cloud backup и device-to-device
  transfer. Источник: https://developer.android.com/identity/data/autobackup
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
